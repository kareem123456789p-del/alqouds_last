# ─────────────────────────────────────────────────────────────
# TEST ENVIRONMENT ONLY — never point this at a real database.
# The suite aborts unless the database name starts with alquods_test.
# Copy to .env.test and adjust the port if your local PostgreSQL
# cluster listens somewhere else.
# ─────────────────────────────────────────────────────────────
NODE_ENV=test
PORT=0
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/alquods_test_main
# Password used by all seeded test users (bcrypt cost 4).
TEST_USER_PASSWORD=Passw0rd!
